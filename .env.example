DB_PATH=data/jobs.db
LOG_LEVEL=INFO
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=50
TELEGRAM_ALERT_ON_ABORT=true
# Shared proxy for blocked services (Telegram + GitHub).
# e.g. socks5://127.0.0.1:1080 or socks5h://127.0.0.1:1080 (DNS via proxy).
OUTBOUND_PROXY=
# Optional per-service overrides (both fall back to OUTBOUND_PROXY, then HTTP_PROXY).
TELEGRAM_PROXY=
GITHUB_PROXY=
LLM_API_KEY=
# Legacy/general proxy, used by the LLM and as the last proxy fallback.
# Not used by the Jobinja crawler.
HTTP_PROXY=
GITHUB_USERNAME=
GITHUB_TOKEN=
# Optional JSON list of searches. Defaults cover Jobinja and JobVision.
# SEARCHES=[{"source":"jobinja","keywords":["python"],"remote":true},{"source":"jobvision","keywords":["python"],"remote":true}]
